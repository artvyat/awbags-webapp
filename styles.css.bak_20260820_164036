/* ============================================================
   🎛🎛🎛  ГЛАВНАЯ ПАНЕЛЬ УПРАВЛЕНИЯ ДИЗАЙНОМ  🎛🎛🎛
   Меняешь цифру здесь → меняется во всём приложении.
   Все размеры в px. Цвета — hex.
   ============================================================ */
:root {
  /* ---------- ПАЛИТРА ---------- */
  --bg: #FFFFFF;
  --card: #FFFFFF;
  --border: #F4D7D7;
  --border-active: #E8A5A5;
  --text: #3A2418;
  --text-soft: #8B6F5C;
  --heading: #5C3B1E;
  --pink: #F4C5C5;
  --pink-strong: #E8A5A5;
  --pink-text: #6B2C2C;
  --disabled: #E8DDD2;
  --brown-btn: #5C3B1E;
  --shadow: 0 2px 8px rgba(92, 59, 30, 0.06);

  /* ---------- ГЛОБАЛЬНОЕ ---------- */
  --radius: 16px;          /* скругление карточек/окон */
  --radius-sm: 10px;       /* скругление плиток/полей */
  --font-base: 15px;       /* базовый шрифт body */
  --app-maxw: 480px;       /* макс ширина приложения */

  /* ---------- ЛОГОТИП В ШАПКЕ ---------- */
  --logo-h: 44px;          /* высота логотипа */

  /* ---------- ЗАГОЛОВКИ ---------- */
  --catalog-title-size: 34px;  /* "СУМКИ" */
  --step-title-size: 20px;     /* "Сумка" / "Вышивка" */
  --group-title-size: 14px;    /* "Модель" / "Материал" */

  /* ---------- КАТЕГОРИИ (табы сверху) ---------- */
  --cat-tab-padv: 10px;    /* вертикальный отступ внутри */
  --cat-tab-padh: 22px;    /* горизонтальный отступ */
  --cat-tab-size: 14px;    /* размер текста */
  --cat-tab-gap: 10px;     /* расстояние между табами */

  /* ---------- КАТАЛОГ (плитки товаров) ---------- */
  --catalog-cols: 2;       /* колонок в сетке (2 = как сейчас) */
  --catalog-gap: 12px;     /* расстояние между карточками */
  --catalog-img-scale: 1.3;/* масштаб фото товара */
  --catalog-name-size: 14px;
  --catalog-btn-size: 13px;
  --catalog-btn-padv: 11px;

  /* ---------- ПРЕВЬЮ СУМКИ (большое окно) ---------- */
  --preview-h: 400px;      /* высота окна превью */
  --preview-scale: 0.45;   /* масштаб сумки внутри */

  /* ---------- ЧИПЫ (Модель/Материал/Шрифт/Зона) ---------- */
  --chip-padv: 8px;        /* верт. отступ */
  --chip-padh: 14px;       /* гор. отступ */
  --chip-size: 14px;       /* размер текста */
  --chip-gap: 8px;         /* между чипами */

    /* ---------- ЗОНЫ (расположение вышивки) ---------- */
  --zone-chip-padv: 8px;         /* верт. отступ внутри чипа зоны */
  --zone-chip-padh: 14px;        /* гор. отступ */
  --zone-chip-size: 14px;        /* размер текста */
  --zone-chip-gap: 8px;          /* между чипами зон */
  --zone-soon-size: 11px;        /* размер бейджа «скоро» */
  --zone-soon-color: #A8907C;    /* цвет бейджа «скоро» */

  /* ---------- ПЛИТКИ ЦВЕТА СУМКИ ---------- */
  --color-tile-min: 72px;   /* мин. ширина плитки (auto-fill), как у ниток */
  --color-tile-gap: 8px;
  --color-tile-name-size: 11px;

  /* ---------- ПЛИТКИ ЦВЕТА НИТОК ---------- */
  --thread-min: 72px;      /* мин. ширина плитки (auto-fill) */
  --thread-gap: 8px;
  --thread-name-size: 11px;

  /* ---------- ПОЛЕ ТЕКСТА ---------- */
  --textarea-minh: 80px;
  --textarea-size: 15px;

  /* ---------- КНОПКИ НАВИГАЦИИ (низ) ---------- */
  --btn-padv: 12px;        /* высота кнопки */
  --btn-padh: 22px;        /* ширина кнопки */
  --btn-size: 15px;        /* размер текста */
}


* { box-sizing: border-box; }
html, body {
  margin: 0; padding: 0;
  background: var(--bg);
  color: var(--text);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: var(--font-base);
  line-height: 1.4;
  -webkit-tap-highlight-color: transparent;
}


/* ===== Шапка с логотипом ===== */
.app-header {
  display: flex;
  justify-content: center;
  padding: 10px 0 4px;
}
.app-logo {
  height: var(--logo-h);
  width: auto;
  object-fit: contain;
}


/* ===== App / Step ===== */
.app {
  padding: 4px 16px 100px;
  max-width: var(--app-maxw);
  margin: 0 auto;
}
.step.hidden { display: none; }
.step-title {
  margin: 16px 0 12px;
  font-size: var(--step-title-size);
  font-weight: 700;
  color: var(--heading);
}
.group-title {
  margin: 18px 0 8px;
  font-size: var(--group-title-size);
  font-weight: 600;
  color: var(--heading);
}


/* ===== ПРЕВЬЮ СУМКИ (большое окно) ===== */
.preview-frame {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--preview-h);   /* 🔧 крути --preview-h вверху */
  padding: 0;
  overflow: hidden;
}
.preview-frame img {
  width: auto;
  height: auto;
  max-width: none;
  max-height: none;
  object-fit: contain;
  transform: scale(var(--preview-scale));  /* 🔧 крути --preview-scale */
}


/* ===== Опции (pill-чипы) ===== */
.options {
  display: flex;
  flex-wrap: wrap;
  gap: var(--chip-gap);
}
.chip {
  background: var(--card);
  border: 1.5px solid var(--border);
  border-radius: 999px;
  padding: var(--chip-padv) var(--chip-padh);
  font-size: var(--chip-size);
  color: var(--text);
  cursor: pointer;
  transition: all 0.15s ease;
  user-select: none;
}
.chip:active { transform: scale(0.97); }
.chip.active {
  background: var(--pink);
  border-color: var(--pink-strong);
  color: var(--pink-text);
  font-weight: 600;
}
.chip.disabled {
  background: var(--disabled);
  color: var(--text-soft);
  cursor: not-allowed;
  opacity: 0.6;
}
.chip .soon {
  font-size: 11px;
  color: var(--text-soft);
  margin-left: 4px;
}


/* ===== ПЛИТКИ ЦВЕТА СУМКИ (сетка как у ниток) ===== */
.color-options {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(var(--color-tile-min), 1fr));
  gap: var(--color-tile-gap);
}
.color-tile {
  cursor: pointer;
  border: 2px solid transparent;
  border-radius: var(--radius-sm);
  padding: 4px;
  text-align: center;
  transition: all 0.15s ease;
}
.color-tile:active { transform: scale(0.95); }
.color-tile.active {
  border-color: var(--pink-strong);
  box-shadow: none;
}
.color-tile img {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 8px;
  border: 1px solid var(--border);
  object-fit: cover;
  display: block;
}
.color-tile-name {
  font-size: var(--color-tile-name-size);
  color: var(--text-soft);
  margin-top: 3px;
  line-height: 1.2;
  white-space: normal;
  word-break: break-word;
}


/* ===== Цвета ниток ===== */
.thread-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(var(--thread-min), 1fr));
  gap: var(--thread-gap);
}
.thread-tile {
  cursor: pointer;
  border: 2px solid transparent;
  border-radius: var(--radius-sm);
  padding: 4px;
  text-align: center;
  transition: all 0.15s ease;
}
.thread-tile:active { transform: scale(0.95); }
.thread-tile.active {
  border-color: var(--pink-strong);
}
.thread-swatch {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 8px;
  border: 1px solid var(--border);
  object-fit: cover;
  display: block;
}
.thread-name {
  font-size: var(--thread-name-size);
  color: var(--text-soft);
  margin-top: 3px;
  line-height: 1.2;
}


/* ===== Textarea ===== */
textarea {
  width: 100%;
  min-height: var(--textarea-minh);
  background: var(--card);
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 12px;
  font-family: inherit;
  font-size: var(--textarea-size);
  color: var(--text);
  resize: vertical;
  outline: none;
  transition: border-color 0.15s;
}
textarea:focus { border-color: var(--pink-strong); }
.hint {
  font-size: 12px;
  color: var(--text-soft);
  margin-top: 6px;
}
.hint.error { color: #C73E3E; }


/* ===== Navbar ===== */
.navbar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: var(--bg);
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  border-top: 1px solid var(--border);
  z-index: 10;
}
.navbar.hidden,
#navbar.hidden {
  display: none !important;
}
.btn {
  border-radius: 999px;
  padding: var(--btn-padv) var(--btn-padh);
  font-size: var(--btn-size);
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  border: none;
  transition: all 0.15s;
}
.btn:active { transform: scale(0.97); }
.btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}
.btn-primary {
  background: var(--brown-btn);
  color: #FFFFFF;
}
.btn-primary:hover:not(:disabled) {
  opacity: 0.9;
}
.btn-ghost {
  background: transparent;
  color: var(--text-soft);
}
.progress {
  font-size: 13px;
  color: var(--text-soft);
}


/* ===== Каталог (шаг 0) ===== */
.catalog-grid {
  display: grid;
  grid-template-columns: repeat(var(--catalog-cols), 1fr);  /* 🔧 крути --catalog-cols */
  gap: var(--catalog-gap);
  margin-top: 8px;
}
.catalog-card {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.catalog-photo {
  position: relative;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  aspect-ratio: 1;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow);
}
.catalog-photo img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  transform: scale(var(--catalog-img-scale));  /* 🔧 крути --catalog-img-scale */
}
.catalog-badge {
  position: absolute;
  top: 8px;
  left: 8px;
  background: var(--pink);
  color: var(--pink-text);
  font-size: 11px;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 999px;
}
.catalog-name {
  font-size: var(--catalog-name-size);
  font-weight: 600;
  color: var(--heading);
  margin: 0;
}
.catalog-subtitle {
  font-size: 12px;
  color: var(--text-soft);
  margin: -4px 0 0;
}
.catalog-price {
  font-size: 13px;
  color: var(--text-soft);
  margin: -4px 0 0;
}
.catalog-btn {
  background: var(--brown-btn);
  color: #fff;
  border: none;
  border-radius: 999px;
  padding: var(--catalog-btn-padv) 12px;
  font-size: var(--catalog-btn-size);
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  transition: transform 0.15s, opacity 0.15s;
}
.catalog-btn:active { transform: scale(0.97); opacity: 0.9; }


/* ===== Заголовок каталога ===== */
.catalog-title {
  text-align: center;
  font-size: var(--catalog-title-size);
  font-weight: 700;
  letter-spacing: 2px;
  color: var(--heading);
  margin: 4px 0 12px;
}


/* ===== Категории — овальные кнопки ===== */
.category-tabs {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--cat-tab-gap);
  margin-bottom: 16px;
}
.category-tab {
  padding: var(--cat-tab-padv) var(--cat-tab-padh);
  border: 1.5px solid var(--heading);
  border-radius: 999px;
  background: transparent;
  color: var(--heading);
  font-size: var(--cat-tab-size);
  font-weight: 500;
  cursor: pointer;
  user-select: none;
  transition: background 0.15s, color 0.15s;
}
.category-tab.active {
  background: var(--heading);
  color: #FFFFFF;
}


/* ===== Заглушка пустой категории ===== */
.catalog-empty {
  grid-column: 1 / -1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48px 16px;
  text-align: center;
  opacity: 0.7;
}
.catalog-empty-icon {
  font-size: 48px;
  margin-bottom: 12px;
}
.catalog-empty-text {
  font-size: 15px;
  color: #888;
  margin: 0;
}